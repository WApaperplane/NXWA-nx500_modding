  "notes": {
    "tint_encoding": "tint = (tint_a << 16) | tint_b，中性 458759 = 0x070007",
    "k_range": "2500-10000，100K 一挡（prefman 不裁剪，范围需自行夹紧）",
    "k_meaning": "K 值表达该胶片的固有色温倾向；与 tint 叠加后得到最终白平衡",
    "slot_rotation": "4 槽轮转（prefman 风格索引 9-12 = CUSTOM_1-4，DATA ID = 0x140000+N），配方切换时不必重写全部 14 槽",
    "bw_technique": "SAT=0 得黑白；保留 R/B 增益差得暖调/冷调黑白（机身独有）",
